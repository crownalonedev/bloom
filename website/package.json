{
  "name": "bloom-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bloom Framework documentation website (static, Cloudflare Workers static assets).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "wrangler dev",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "github-slugger": "2.0.0",
    "globals": "17.13.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
