    {
      "name": "website-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "dev", "--", "--port", "5173", "--host", "127.0.0.1"],
      "port": 5173
    }
  ]
}
