{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "preview", "--", "--port", "8787", "--ip", "127.0.0.1"],
      "port": 8787,
      "env": { "WRANGLER_SEND_METRICS": "false" }
